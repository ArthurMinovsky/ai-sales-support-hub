# Copy to .env before launching Docker. Replace demo JWT key with a long unpredictable value.
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# Docker selects free published host ports. Set an explicit number to override.
API_PORT=0
WEB_PORT=0
# Blank for direct Docker access: Origin must match request Host and scheme.
# Set the exact public HTTPS origin when deploying behind a reverse proxy.
APP_ORIGIN=
