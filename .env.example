# Safe template only. Copy to the ignored .env file; never commit real credentials.
# Generate JWT_SECRET with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Optional for startup/CRUD; required for live AI recommendations.
OPENROUTER_API_KEY=
# Select an available OpenRouter model that supports JSON object responses.
OPENROUTER_MODEL=REPLACE_WITH_AVAILABLE_JSON_MODEL_ID
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# Docker selects free published host ports. Set an explicit number to override.
API_PORT=0
WEB_PORT=0
# Blank for direct Docker access: Origin must match request Host and scheme.
# Set the exact public HTTPS origin when deploying behind a reverse proxy.
APP_ORIGIN=
# Compose supplies DATABASE_URL and BACKEND_INTERNAL_URL inside the containers.
